# ========================================================
# Euro Edge Technical Services L.L.C. - SMTP Configuration
# ========================================================
# To enable real two-way email delivery (sending inquiry to
# info@euroedgets.com and automatic confirmation to the customer),
# configure these environment variables in your deployment (Vercel)
# or in a local ".env.local" file.

# 1. SMTP Server Host (default for Zoho Mail is smtp.zoho.com; for Google Workspace is smtp.gmail.com)
SMTP_HOST=smtp.zoho.com

# 2. SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# 3. Secure connection (true for port 465, false for 587)
SMTP_SECURE=true

# 4. Official sending mailbox username & password / app password
SMTP_USER=info@euroedgets.com
SMTP_PASS=your_email_or_app_password_here

# 5. Destination email where technical inquiries are delivered
NOTIFICATION_EMAIL=info@euroedgets.com
